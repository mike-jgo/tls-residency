# Copy to .env and fill in. Never commit the real .env.
PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-something-strong
ORG_NAME=TLS
TZ=Asia/Manila
# The longest a single session may be, in hours. Two things follow from it:
# a session longer than this counts as zero, and a tap arriving more than this
# long after a check-in is treated as a new arrival rather than a check-out.
# Set it above the longest shift anyone genuinely works.
MAX_SESSION_HOURS=10
# Where the SQLite file lives (defaults to ./residency.db)
# DB_PATH=/var/lib/tls-residency/residency.db
# Where backups go (defaults to ./backups, which is on the same SD card as the
# database — point it at a USB stick), and how many to keep. Two are taken a
# day: one at startup, one at Shut down.
# BACKUP_DIR=/media/usb/residency-backups
# BACKUP_KEEP=60
# Google Sheets sync — off unless SHEETS_SPREADSHEET_ID is set. The ID is the
# long part of the sheet's address: docs.google.com/spreadsheets/d/<ID>/edit
# Share the sheet (as Editor) with the service account's email address.
# SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
